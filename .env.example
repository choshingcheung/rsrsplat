# Copy to .env and fill in. .env is gitignored and must never be committed.

# Stage S7: natural language -> articulation schema.
# Absent or unreachable, the service falls back to stored schemas and still works.
ANTHROPIC_API_KEY=

# Phase 9: image -> mesh, so an object's unobserved back is not a hollow when it tumbles.
# Absent, objects keep their scanned splats and everything else still works.
TRIPO_API_KEY=

# Where generated meshes are cached. Defaults to assets/meshes. Large binaries, gitignored.
RSRSPLAT_MESH_DIR=

# Path to a directory holding splat captures (.ply). Large files live outside the repo.
SPLAT_CAPTURE_DIR=

# Service bind address, used by both the service and the web dev proxy.
RSRSPLAT_HOST=127.0.0.1
RSRSPLAT_PORT=8000
